
name: Mahjong Drachenwelt APK

on:
  workflow_dispatch:
  push:
    branches: [main]

permissions:
  contents: read

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - name: Repository laden
        uses: actions/checkout@v4

      - name: Java einrichten
        uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"

      - name: Android SDK einrichten
        uses: android-actions/setup-android@v3

      - name: Gradle einrichten
        uses: gradle/actions/setup-gradle@v4
        with:
          gradle-version: "8.9"

      - name: Android-Projekt entpacken
        run: |
          unzip -q MahjongDrachenwelt_AndroidStudio_Projekt.zip -d buildsrc
          test -f buildsrc/MahjongDrachenwelt/app/build.gradle.kts
          test -f buildsrc/MahjongDrachenwelt/settings.gradle.kts

      - name: APK bauen
        working-directory: buildsrc/MahjongDrachenwelt
        run: gradle --no-daemon assembleDebug

      - name: APK bereitstellen
        uses: actions/upload-artifact@v4
        with:
          name: Mahjong-Drachenwelt-APK
          path: buildsrc/MahjongDrachenwelt/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
          retention-days: 14
